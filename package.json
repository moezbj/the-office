{
  "name": "my-office-app",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "import-certificate": "bash ./import_certificate.sh",
    "publish": "electron-builder --mac -p always",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@apollo/client": "^4.2.2",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "axios": "^1.17.0",
    "date-fns": "^4.4.0",
    "graphql": "^16.14.1",
    "html-react-parser": "^6.1.3",
    "jodit-react": "^5.3.21",
    "localforage": "^1.10.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.17.0",
    "react-to-print": "^3.3.0",
    "written-number": "^0.11.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.4"
  },
  "author": "mohamed Al moez ben jemaa <moezbj.93@gmail.com>",
  "license": "ISC",
  "build": {
    "appId": "office-schedule-builder",
    "asar": true,
    "extends": null,
    "productName": "office-schedule",
    "directories": {
      "output": "release/${version}"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "mac": {
      "identity": null,
      "sign": false,
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
      "signingHashAlgorithms": [
        "sha256"
      ]

    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "electron-fiddle-deep-link",
        "schemes": [
          "electron-fiddle"
        ]
      }
    ]
  }
}